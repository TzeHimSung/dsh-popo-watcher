{
  "name": "dsh-popo-watcher",
  "version": "0.1.4",
  "description": "POPO group monitoring, reply evaluation, and chat controls for DeepSeek Harness 0.2",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "docs/interfaces.md"
  ],
  "license": "GPL-3.0-only",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "build:client": "node tools/build-client.mjs",
    "check:client": "node tools/build-client.mjs --check",
    "dev:client": "node tools/build-client.mjs --watch",
    "test": "node tools/build-client.mjs --check && node tools/test.mjs",
    "test:desktop": "node tools/build-client.mjs --check && node tools/test-desktop.mjs",
    "prepack": "node tools/build-client.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TzeHimSung/dsh-popo-watcher.git"
  },
  "homepage": "https://github.com/TzeHimSung/dsh-popo-watcher#readme",
  "bugs": {
    "url": "https://github.com/TzeHimSung/dsh-popo-watcher/issues"
  }
}
